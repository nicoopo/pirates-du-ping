# Copier en .env (jamais commité) et remplacer les valeurs.
# Le tableau de la classe
TABLEAU_URL=https://services-battle.vercel.app
GROUPE=nom-de-l-equipage
COULEUR=#e05252

# La base : le mot de passe ne vit que dans .env et dans les secrets GitHub
DB_HOST=db
DB_USER=flotte
DB_PASSWORD=changeme
DB_NAME=flotte

# Le pavillon : DOIT être dans un volume, sinon il disparaît au prochain déploiement
PAVILLON_FICHIER=/data/pavillon.txt

# À remplir quand les images seront publiées (compatibles linux/arm64).
# Utiliser des tags de version ou des digests précis.
FRONT_IMAGE=
API_IMAGE=
ANNEXE_IMAGE=
VERSION=dev
